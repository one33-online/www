{
  "permissions": {
    "allow": [
      "Skill(shadcn)",
      "Skill(shadcn:*)",
      "WebSearch",
      "WebFetch(domain:zapper.gitbook.io)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npm run fix -- --skip=correctness/noUnusedImports"
          }
        ]
      }
    ]
  }
}
